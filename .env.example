# Empty credential template — safe to include in Git.
# Set real values privately in your hosting provider's Variables panel.
DATABASE_URL=
# Random private signing secret of at least 32 characters.
AUTH_SECRET=
# Needed only for first-time owner setup in an empty production database.
ADMIN_EMAIL=
# At least 12 characters including letters and numbers. Never use a public default.
ADMIN_PASSWORD=
# Explicitly enable only for an intentional owner password reset, then disable.
RESET_ADMIN_PASSWORD=false
# HTTPS production origin, supplied after publishing; not a preview URL.
NEXT_PUBLIC_SITE_URL=
# Leave empty for local development (uses ./uploads).
# In production set an ABSOLUTE path backed by a persistent Volume, e.g. /app/uploads.
UPLOAD_DIR=
# Optional bounded PostgreSQL pool size. Tune for the actual production database.
DB_POOL_MAX=10
